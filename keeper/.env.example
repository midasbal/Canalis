# Arc testnet RPC endpoint
RPC_URL=https://rpc.testnet.arc.network/

# Deployed CanalisExecutor address (see CLAUDE.md "Current deployed addresses")
EXECUTOR_ADDRESS=0xYOUR_EXECUTOR_ADDRESS_HERE

# The CanalisAccount this keeper services. Flows are discovered via
# flowsOf(CANALIS_ACCOUNT) — a single eth_call, not a getLogs scan — so
# this keeper only ever drives ONE account's flows. Fine for the
# single-user demo; multi-account enumeration is future work (see
# README.md "Flow discovery").
CANALIS_ACCOUNT=0xYOUR_CANALIS_ACCOUNT_ADDRESS_HERE

# Hot key for the keeper. This key ONLY ever calls executeFlow() — it can't
# move user funds directly (CanalisAccount only trusts the executor
# contract's own logic, not this key). It still needs a small amount of
# gas USDC (Arc's native gas token, 18 decimals) to pay for its own
# transactions. Never commit a real value here.
KEEPER_PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY_HERE

# How often to poll, in milliseconds. Keep this short (e.g. 60000 = 60s)
# for a live demo so scheduled/threshold flows visibly fire on their own.
POLL_INTERVAL_MS=60000

# Pyth's real IPyth contract on Arc testnet (see CLAUDE.md "Current
# deployed addresses" / contracts/script/Deploy.s.sol). The keeper reads
# stored prices here and pushes fresh ones via updatePriceFeeds before
# evaluating any flow with an oracle price condition. See README.md
# "Oracle price updates".
ORACLE_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43

# Pyth's PRODUCTION Hermes price-update API — free, no API key. Do NOT
# point this at hermes-beta.pyth.network: Arc testnet's deployed Pyth
# contract verifies against the real production Wormhole guardian set and
# rejects hermes-beta-signed updates with "InvalidWormholeVaa" (confirmed
# on-chain — see README.md "Oracle price updates" / CLAUDE.md).
HERMES_URL=https://hermes.pyth.network
