# Arc testnet RPC. Optional — falls back to the public RPC
# (https://rpc.testnet.arc.network/) if unset, which rate-limits bursts of
# parallel calls (the same limit the keeper had to self-pace around). Point
# this at a keyed endpoint (Alchemy/QuickNode/etc.) to avoid it; reads also
# go through a rate-limit-aware transport regardless (see
# src/lib/rateLimitedTransport.ts) as a safety net either way.
VITE_ARC_RPC_URL=

# CanalisExecutor / CanalisAccountFactory addresses once deployed (see
# contracts/script/Deploy.s.sol). Each wallet's own CanalisAccount is
# resolved dynamically via the factory — there's no single fixed account
# address anymore.
VITE_CANALIS_EXECUTOR_ADDRESS=
VITE_CANALIS_ACCOUNT_FACTORY_ADDRESS=

# Block CanalisExecutor was deployed at (see contracts/broadcast/Deploy.s.sol/.../run-latest.json).
# Only used to raise the floor of the run log's recent-history window below
# — NOT as the scan's start on its own (deployBlock→head can be millions of
# blocks). Optional; safe to leave unset.
VITE_CANALIS_EXECUTOR_DEPLOY_BLOCK=

# eth_getLogs chunk size for the run log (historical backfill + live
# catch-up poll). Free-tier RPCs cap this hard — QuickNode as low as 5
# blocks, Alchemy 10 — default is conservative (10). Only raise this if
# your provider's plan actually supports a wider range.
VITE_GETLOGS_CHUNK=10

# How many recent blocks the run log backfills on load, ending at head.
# Deliberately small — NOT deployBlock→head — since at a 10-block chunk
# cap that could mean hundreds of thousands of requests. Old runs beyond
# this window aren't backfilled; live polling covers everything from here
# forward. Default 500.
VITE_RUNLOG_LOOKBACK_BLOCKS=500

# Arc testnet USDC ERC-20 interface (system contract), 6 decimals — used to
# read the connected wallet's USDC balance and to approve/deposit into a
# CanalisAccount.
VITE_USDC_ADDRESS=

# Arc testnet EURC ERC-20 interface, 6 decimals — the Swap action's other
# token, and CanalisSwapPool's address (see contracts/script/Deploy.s.sol).
VITE_EURC_ADDRESS=
VITE_CANALIS_SWAP_POOL_ADDRESS=

# Pyth's real IPyth contract on Arc testnet (see contracts/script/Deploy.s.sol) —
# used by the composer's oracle price condition to show the live oracle price.
# Verifies updates against the real production Wormhole guardian set; the
# keeper must push price updates from hermes.pyth.network (production
# Hermes), not hermes-beta — see keeper/README.md "Oracle price updates".
VITE_ORACLE_ADDRESS=

# --- Natural-language flow builder proxy (api/generate-flow.ts + its dev
# middleware in vite.config.ts) — see README.md "Natural-language flow
# builder". IMPORTANT: none of these are VITE_-prefixed on purpose — Vite
# only inlines VITE_-prefixed vars into the browser bundle, so this whole
# block stays server-side only (read via process.env, never
# import.meta.env). Never commit real values; this file only ever holds
# placeholders.

# Groq API key (https://console.groq.com/keys, free tier). Lives ONLY here
# and in process.env on the server — never sent to or read by the browser.
GROQ_API_KEY=PLACEHOLDER_GROQ_API_KEY

# Optional: override the Groq model (defaults to llama-3.3-70b-versatile,
# a current llama-3.x-70b-class model that supports JSON-mode output).
GROQ_MODEL=

# Comma-separated list of browser Origins allowed to call the proxy.
# Defaults to http://localhost:5173 (Vite's dev port) if unset — set this
# to your real deployed origin (e.g. https://canalis.vercel.app) in
# production so other sites' JS can't silently spend your Groq quota
# through a visitor's browser.
NL_ALLOWED_ORIGIN=http://localhost:5173

# Anti-abuse limits (all optional — sane defaults if unset). Per-IP hourly
# rate limit, a GLOBAL daily cap across every user well under Groq's free
# quota, and a max prompt length. See api/_lib/generateFlow.ts for exactly
# how each is enforced (in-memory counters — reset on process restart).
NL_RATE_LIMIT_PER_IP_PER_HOUR=10
NL_DAILY_GLOBAL_CAP=300
NL_MAX_PROMPT_CHARS=500
